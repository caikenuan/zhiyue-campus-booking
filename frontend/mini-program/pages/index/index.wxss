.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 4rpx 26rpx;
}

.hello {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #0ea5e9);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-banner {
  background: linear-gradient(135deg, #1e3a8a, #2563eb 60%, #0ea5e9);
  border-radius: 24rpx;
  padding: 30rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(37, 99, 235, 0.25);
}

.ai-title {
  font-size: 32rpx;
  font-weight: 700;
}

.ai-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.82);
}

.ai-arrow {
  font-size: 40rpx;
  font-weight: 300;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.quick-item {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.05);
}

.quick-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
}

.quick-text {
  font-size: 24rpx;
  color: #374151;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-head .section-title {
  margin-bottom: 0;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.filter-chip {
  display: inline-block;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 24rpx;
  margin-right: 12rpx;
  border: 1rpx solid #e5e7eb;
}

.filter-chip-active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}

.venue-card {
  padding: 26rpx 28rpx;
}

.venue-name {
  font-size: 31rpx;
  font-weight: 700;
}

.venue-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.venue-footer {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f1f5f9;
}

.venue-link {
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
}
