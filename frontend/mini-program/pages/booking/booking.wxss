.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-width: 130rpx;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 26rpx;
  text-align: center;
}

.chip-active {
  background: #2563eb;
  color: #ffffff;
  font-weight: 700;
}

.summary-card {
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 30rpx;
}

.summary-text {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.submit-btn {
  width: 100%;
}
