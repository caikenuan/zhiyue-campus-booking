<view class="page">
  <view class="user-card">
    <view class="avatar">{{avatarText}}</view>
    <view class="user-info">
      <view class="user-name">{{user.name || '未登录'}}</view>
      <view class="user-meta">{{user.studentNo}} · {{roleLabel}}</view>
    </view>
    <view wx:if="{{score !== null}}" class="score-badge">
      <view class="score-num">{{score}}</view>
      <view class="score-label">信用分</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">服务地址</view>
    <input class="input" value="{{apiBase}}" bindinput="onApiInput" placeholder="http://localhost:3000/api" />
    <view class="muted" style="margin-top: 12rpx;">
      真机预览时改成电脑局域网 IP，例如 http://192.168.1.10:3000/api，并保证手机和电脑同一网络。
    </view>
    <view class="setting-actions">
      <button class="btn-ghost btn-small" bindtap="resetApiBase">恢复默认</button>
      <button class="btn-primary btn-small" bindtap="saveApiBase">保存地址</button>
    </view>
  </view>

  <view class="card">
    <view class="menu-row" bindtap="about">
      <text>关于智约</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="logout">
      <text style="color: #b91c1c;">退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer">
    《专业基础实践》课程项目 · 版本 0.1.0
  </view>
</view>
