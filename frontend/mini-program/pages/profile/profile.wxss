.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1e3a8a, #2563eb);
  border-radius: 24rpx;
  padding: 34rpx 28rpx;
  color: #ffffff;
  margin-bottom: 22rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  margin-right: 22rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
}

.user-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  opacity: 0.88;
}

.score-badge {
  text-align: center;
}

.score-num {
  font-size: 44rpx;
  font-weight: 800;
}

.score-label {
  font-size: 21rpx;
  opacity: 0.88;
}

.setting-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 20rpx;
}

.setting-actions button {
  margin: 0;
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 28rpx;
  color: #111827;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #9ca3af;
  font-size: 34rpx;
}

.footer {
  text-align: center;
  color: #9ca3af;
  font-size: 21rpx;
  padding: 20rpx 0 30rpx;
}
