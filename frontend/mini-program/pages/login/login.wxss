.login-page {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 20% 10%, rgba(37, 99, 235, 0.16), transparent 45%),
    radial-gradient(circle at 80% 90%, rgba(14, 165, 233, 0.14), transparent 45%),
    #f8fafc;
}

.hero {
  text-align: center;
  margin-bottom: 48rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 18rpx;
  color: #111827;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.login-card {
  padding: 36rpx 30rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field-label {
  font-size: 24rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.login-btn {
  margin-top: 12rpx;
}

.demo-card {
  margin-top: 24rpx;
}

.demo-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.demo-code {
  color: #2563eb;
  font-size: 22rpx;
}

.demo-note {
  margin-top: 14rpx;
  line-height: 1.6;
}
