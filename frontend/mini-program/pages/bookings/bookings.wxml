<view class="page">
  <scroll-view scroll-x class="status-tabs" enhanced show-scrollbar="{{false}}">
    <view class="status-tab-row">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="status-tab {{status === item.value ? 'status-tab-active' : ''}}"
        bindtap="setStatus"
        data-status="{{item.value}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{items.length === 0}}" class="empty">暂无预约记录</view>

  <view wx:for="{{items}}" wx:key="id" class="card booking-card" bindtap="goDetail" data-id="{{item.id}}">
    <view class="between">
      <view class="booking-name">{{item.resourceName}}</view>
      <view class="tag {{item.statusClass}}">{{item.statusLabel}}</view>
    </view>
    <view class="muted" style="margin-top: 12rpx;">
      {{item.startText}} - {{item.endText}}
    </view>
    <view class="muted" style="margin-top: 6rpx;">
      {{item.building}} {{item.room}}
    </view>
    <view class="actions" catchtap="noop">
      <button class="btn-ghost btn-small" bindtap="goDetail" data-id="{{item.id}}">详情</button>
      <button
        wx:if="{{item.canCheckin}}"
        class="btn-primary btn-small"
        bindtap="goCheckin"
        data-id="{{item.id}}"
      >去签到</button>
      <button
        wx:if="{{item.canCancel}}"
        class="btn-danger btn-small"
        bindtap="cancelBooking"
        data-id="{{item.id}}"
      >取消</button>
    </view>
  </view>
</view>
