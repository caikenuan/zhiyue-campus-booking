page {
  background: #f5f7fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.page {
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.05);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.brand {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #1d4ed8;
}

.btn-primary {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  line-height: 1.2;
}

.btn-primary[disabled] {
  background: #93c5fd;
  color: #ffffff;
}

.btn-ghost {
  background: #eff6ff;
  color: #1d4ed8;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1.2;
}

.btn-danger {
  background: #fef2f2;
  color: #dc2626;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1.2;
}

.btn-small {
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  display: inline-block;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-blue {
  background: #eff6ff;
  color: #1d4ed8;
}

.tag-green {
  background: #ecfdf5;
  color: #047857;
}

.tag-orange {
  background: #fff7ed;
  color: #c2410c;
}

.tag-red {
  background: #fef2f2;
  color: #b91c1c;
}

.tag-gray {
  background: #f3f4f6;
  color: #4b5563;
}

.divider {
  height: 1rpx;
  background: #eef2f7;
  margin: 22rpx 0;
}

.input {
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
