# 复制为 .env 后使用；.env 不会提交到仓库
PORT=3000
JWT_SECRET=replace-with-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhiyue
DB_USER=zhiyue
DB_PASSWORD=zhiyue_dev
# 云数据库强制 TLS 时设为 true
DB_SSL=false
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
# 初始化脚本授权的主机；本地默认 %（兼容 localhost/127.0.0.1），
# 云数据库可收紧为服务器固定 IP，例如 10.0.0.5
DB_USER_HOSTS=%

# AI 找位助手：不填时自动使用本地规则解析，仍可完整演示
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 图片上传：local 写到 STORAGE_LOCAL_DIR（默认 backend/uploads），由后端托管；
# 上云后改为 s3，填对象存储（阿里云 OSS / 腾讯云 COS / MinIO / R2）。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
