# 复制为 deploy/.env 后填写；.env 已被 .gitignore 忽略，禁止提交真实密码。
# 生成随机串：openssl rand -base64 36

# MySQL root 密码（仅容器初始化/管理使用）
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING

# 业务数据库
DB_NAME=zhiyue
DB_USER=zhiyue
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING
# 使用云数据库（Aiven/TiDB Cloud/RDS）通常需要 TLS
DB_SSL=false

# JWT 签名密钥，长度至少 32 字符
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# AI 找位助手（可选；不填则使用本地规则解析）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 图片上传：local 存容器数据卷（uploads_data），s3 走 OSS/COS/R2/MinIO
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
